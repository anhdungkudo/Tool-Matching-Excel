{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "msedge",
            "request": "launch",
            "name": "Mở Tool bằng Microsoft Edge (Trực tiếp)",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Mở Tool bằng Google Chrome (Trực tiếp)",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Chạy qua Localhost (http://localhost:8080)",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}